{
  "name": "iades",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "description": "Indian Air Defence Educational Simulator",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "npm run migrate --workspace=apps/server",
    "db:seed": "npm run seed --workspace=apps/server",
    "db:studio": "npm run studio --workspace=apps/server",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
